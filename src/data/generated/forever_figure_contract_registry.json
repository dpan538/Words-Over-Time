      "recordGranularityAndN": {
        "granularity": "dataset × period × coverage state",
        "n": {
          "currentDatasets": 4
        }
      },
      "filters": [
        "registered search scope only"
      ],
      "grouping": [
        "dataset",
        "year/decade",
        "document/token/record coverage state"
      ],
      "denominator": "registered source universe per layer",
      "formulaTransform": "coverage state derived from retained search/capture log, never from numeric zero",
      "unit": "documents, tokens, records, and explicit coverage state",
      "visualChannelMapping": [
        {
          "channel": "cell text + shape",
          "field": "coverage state",
          "mapping": "distinct redundant state marker"
        },
        {
          "channel": "facet",
          "field": "dataset",
          "mapping": "one source layer per facet"
        }
      ],
      "validInterpretation": [
        "Where evidence is present, absent, unsearched, unavailable, or incomparable."
      ],
      "prohibitedInterpretation": [
        "A blank area is evidence of zero usage."

  "findings": [
    {
      "id": "finding-ngram-denominator",
      "status": "audited-blocker",
      "productionEligible": false,
      "question": "Can joined 'forever' and spaced 'for ever' share an appearances-per-million scale?",
      "rawFields": [
        {
          "path": "src/data/generated/forever_frequency.json",
          "selector": "series[query in {'forever','for ever'}]",
          "fields": [
            "query",
            "points[].value",
            "source.corpus",
            "source.url"
          ]
        },
        {
          "path": "docs/research/forever/sources/google-ngram-official-authority.json",
          "selector": "sourceRecords[id='google-ngram-viewer-denominator']",
          "fields": [
            "url",
            "applicableClaim",
            "sourceLocation",
            "accessedOn"
          ]
        }
      ],
      "filters": [
        "query is exactly 'forever' or 'for ever'",
        "smoothing=0",
        "case_insensitive=false"
      ],
      "grouping": [
        "query",
        "year"
      ],
      "denominator": "Viewer-specific all-unigram denominator for forever; all-bigram denominator for for ever",
      "transformFormula": "Viewer fraction × 1,000,000, with unit retained by n-gram order",
      "result": {
        "summary": "Only option B is present: separate Viewer-normalized facets; a shared joined/spaced scale is invalid.",
        "values": {
          "foreverOrder": 1,
          "forEverOrder": 2,
          "rawMatchCountsAvailable": false,
          "annualWordTokenTotalsAvailable": false,
          "sharedScaleAllowed": false
        }
      },
      "caveat": [
        "Corpus release is not pinned.",
        "No raw response or official bulk rows are retained."
      ],
      "sourceRowsFiles": [
        {
          "path": "src/data/generated/forever_frequency.json",
          "selector": "source",
          "fields": [
            "corpus",
            "url",
            "smoothing",
            "startYear",
            "endYear"
          ]
        },
        {
          "path": "scripts/fetch_ngram_forever.ts",
          "selector": "URL construction and response mapping",
          "fields": [
            "content",
            "corpus",
            "smoothing",
            "case_insensitive",
            "timeseries"
          ]
        },
        {
          "path": "docs/research/forever/sources/google-ngram-official-authority.json",
          "selector": "sourceRecords[id in {'google-ngram-viewer-denominator','google-ngram-viewer-release-mutation'}]",
          "fields": [
            "publisher",
            "title",
            "url",
            "accessedOn",
            "applicableClaim",
            "repositoryUse"
          ]
        }
      ],
      "blockedByGapIds": [
        "gap-google-raw-response-release",
        "gap-google-common-denominator"
      ]
    },
    {
      "id": "finding-ngram-window",
      "status": "audited-limited-result",
      "productionEligible": false,
      "question": "What is the actual granularity of the historical 323-row Forever table?",
      "rawFields": [
        {
          "path": "src/data/generated/forever_frequency.json",
          "selector": "series[query='forever'].points",
          "fields": [
            "year",
            "value",
            "frequencyPerMillion"
          ]
        }
      ],
      "filters": [
        "query='forever'",
        "1700 <= year <= 2022"
      ],
      "grouping": [
        "one row per year"
      ],
      "denominator": "all unigrams in each Viewer corpus-year",
      "transformFormula": "inclusive filter; row_count = 2022 - 1700 + 1",
      "result": {
        "summary": "The table is 323 Viewer-normalized annual unigram observations, not 323 raw match-count rows.",
        "values": {
          "rowCount": 323,
          "firstYear": 1700,
          "lastYear": 2022
        }
      },
      "caveat": [
        "Numeric zero is not a typed missingness state.",
        "The raw API response is absent."
      ],
      "sourceRowsFiles": [
        {
          "path": "src/data/generated/forever_frequency.json",
          "selector": "series[query='forever'].points[1700..2022]",
          "fields": [
            "year",
            "value"
          ]
        }
      ],
      "blockedByGapIds": [
        "gap-google-raw-response-release"
      ]
    },
    {
      "id": "finding-gutenberg-inventory",
      "status": "audited-limited-result",
      "productionEligible": false,
      "question": "What joined/spaced counts exist inside the selected Gutenberg inventory?",
      "rawFields": [
        {
          "path": "src/data/generated/forever_gutenberg_sources.json",
          "selector": "sources[] and sources[].occurrences[kind='form']",
          "fields": [
            "id",
            "year",
            "tokenCount",
            "kind",
            "phrase",
            "tokenIndex"
          ]
        }
      ],
      "filters": [
        "23 manually selected works",
        "occurrence.kind='form'",
        "phrase exactly 'forever' or 'for ever'"
      ],
      "grouping": [
        "form",
        "selected work"
      ],
      "denominator": "token count inside the selected 23 processed texts only",
      "transformFormula": "count exact form rows; rate, if used, must equal form_count / selected_text_tokens × 1,000,000",
      "result": {
        "summary": "The generated inventory separates joined and spaced forms, but it is selected-corpus evidence without retained raw texts.",
        "values": {
          "selectedWorks": 23,
          "tokens": 3249043,
          "joinedOccurrences": 133,
          "spacedOccurrences": 188,
          "allFormOccurrences": 321
        }
      },
      "caveat": [
        "Not representative of print generally.",
        "Hyphenated forms may be conflated.",
        "Edition/translation dates are unresolved."
      ],
      "sourceRowsFiles": [
        {
          "path": "src/data/generated/forever_gutenberg_sources.json",
          "selector": "sources[].occurrences[kind='form']",
          "fields": [
            "phrase",
            "tokenIndex",
            "snippet"
          ]
        }
      ],
      "blockedByGapIds": [
        "gap-gutenberg-raw-texts-metadata",
        "gap-canonical-form-registry"
      ]
    },
    {
      "id": "finding-gutenberg-duplicates",
      "status": "audited-blocker",
      "productionEligible": false,
      "question": "Does one generated Gutenberg occurrence row equal one unique source passage position?",
      "rawFields": [
        {
          "path": "src/data/generated/forever_gutenberg_sources.json",
          "selector": "sources[].occurrences[]",
          "fields": [
            "source id",
            "kind",
            "phrase",
            "tokenIndex"
          ]
        }
      ],
      "filters": [
        "all generated occurrence rows"
      ],
      "grouping": [
        "source id + tokenIndex"
      ],
      "denominator": "generated occurrence rows versus unique source-token positions",
      "transformFormula": "duplicate_role_rows = occurrence_rows - unique(source_id, tokenIndex)",
      "result": {
        "summary": "Phrase and form roles create repeated source-token positions; a record-level figure must dedupe passages before counting.",
        "values": {
          "occurrenceRows": 332,
          "uniqueSourceTokenPositions": 329,
          "duplicateRoleRows": 3
        }
      },
      "caveat": [
        "A future passage ID should distinguish one verified passage from its multiple analytic roles."
      ],
      "sourceRowsFiles": [
        {
          "path": "src/data/generated/forever_gutenberg_sources.json",
          "selector": "sources[].occurrences[]",
          "fields": [
            "kind",
            "phrase",
            "tokenIndex"
          ]
        }
      ],
      "blockedByGapIds": [
        "gap-gutenberg-raw-texts-metadata"
      ]
    },
    {
